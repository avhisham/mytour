{
  "file_name": "doa1house.mp3",
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:01,605",
      "text": {
        "ar": "بِسْمِ اللهِ",
        "tl": "Bismillahi",
        "ms": "Dengan nama Allah",
        "en": "In the name of Allah",
        "ml": "അല്ലാഹുവിന്റെ നാമത്തിൽ",
        "ta": "அல்லாஹ்வின் பெயரால்"
      }
    },
    {
      "start": "00:00:01,605",
      "end": "00:00:03,646",
      "text": {
        "ar": "آمَنْتُ بِاللهِ",
        "tl": "amantu billahi",
        "ms": "Aku beriman kepada Allah",
        "en": "I believe in Allah",
        "ml": "ഞാൻ അല്ലാഹുവിൽ വിശ്വസിച്ചു",
        "ta": "அல்லாஹ்வின் மீது நம்பிக்கை கொண்டேன்"
      }
    },
    {
      "start": "00:00:03,623",
      "end": "00:00:05,458",
      "text": {
        "ar": "تَوَكَّلْتُ عَلَى اللهِ",
        "tl": "tawakkaltu 'alallahi",
        "ms": "Aku bertawakkal kepada Allah",
        "en": "I trust in Allah",
        "ml": "അല്ലാഹുവിൽ ഞാൻ ഭരമേൽപ്പിച്ചു",
        "ta": "அல்லாஹ்வின் மீதே முழுமையாகச் சார்ந்திருக்கிறேன்"
      }
    },
    {
      "start": "00:00:05,435",
      "end": "00:00:08,737",
      "text": {
        "ar": "وَ لَا حَوْلَ وَ لَا قُوَّةَ إِلَّا بِاللهِ",
        "tl": "wa la hawla wa la quwwata illa billahi",
        "ms": "Tiada daya dan kekuatan melainkan dengan Allah",
        "en": "There is no power nor might except with Allah",
        "ml": "അല്ലാഹുവിനെക്കൊണ്ടല്ലാതെ യാതൊരു ശക്തിയുമില്ല",
        "ta": "அல்லாஹ்வின் உதவியின்றி மாற்றமோ ஆற்றலோ இல்லை"
      }
    },
    {
      "start": "00:00:08,760",
      "end": "00:00:10,457",
      "text": {
        "ar": "رَبِّ أَعُوذُ بِكَ",
        "tl": "rabbi a'udhu bika",
        "ms": "Wahai Tuhanku, aku berlindung dengan-Mu",
        "en": "My Lord, I seek refuge in You",
        "ml": "എന്റെ നാഥാ, ഞാൻ നിന്നോട് കാവൽ തേടുന്നു",
        "ta": "என் இறைவா, உன்னிடம் பாதுகாப்புத் தேடுகிறேன்"
      }
    },
    {
      "start": "00:00:10,500",
      "end": "00:00:13,094",
      "text": {
        "ar": "أَنْ أَضِلَّ أَوْ أُضَلَّ",
        "tl": "an adilla aw udalla",
        "ms": "Daripada aku tersesat atau disesatkan",
        "en": "From straying or being led astray",
        "ml": "ഞാൻ വഴിപിഴക്കുന്നതിൽ നിന്നോ പിഴപ്പിക്കപ്പെടുന്നതിൽ നിന്നോ",
        "ta": "நான் வழிதவறுவதிலிருந்தோ வழிதவறச் செய்யப்படுவதிலிருந்தோ"
      }
    },
    {
      "start": "00:00:13,117",
      "end": "00:00:15,365",
      "text": {
        "ar": "أَوْ أَزِلَّ أَوْ أُزَلَّ",
        "tl": "aw azilla aw uzalla",
        "ms": "Atau aku tergelincir atau digelincirkan",
        "en": "From slipping or being made to slip",
        "ml": "ഞാൻ തെന്നുന്നതിൽ നിന്നോ തെറ്റിക്കപ്പെടുന്നതിൽ നിന്നോ",
        "ta": "நான் சறுக்குவதிலிருந்தோ சறுக்க வைக்கப்படுவதிலிருந்தோ"
      }
    },
    {
      "start": "00:00:15,296",
      "end": "00:00:17,910",
      "text": {
        "ar": "أَوْ أَظْلِمَ أَوْ أُظْلَمَ",
        "tl": "aw azlima aw uzlama",
        "ms": "Atau aku menzalimi atau dizalimi",
        "en": "From oppressing or being oppressed",
        "ml": "ഞാൻ അക്രമിക്കുന്നതിൽ നിന്നോ അക്രമിക്കപ്പെടുന്നതിൽ നിന്നോ",
        "ta": "நான் அநியாயம் செய்வதிலிருந்தோ அநியாயம் செய்யப்படுவதிலிருந்தோ"
      }
    },
    {
      "start": "00:00:17,887",
      "end": "00:00:21,052",
      "text": {
        "ar": "أَوْ أَجْهَلَ أَوْ يُجْهَلَ",
        "tl": "aw ajhala aw yujhala",
        "ms": "Atau aku melakukan kebodohan atau diperlakukan bodoh",
        "en": "From being ignorant or being treated ignorantly",
        "ml": "ഞാൻ വിവരക്കേട് കാണിക്കുന്നതിൽ നിന്നോ എന്നോട് കാണിക്കപ്പെടുന്നതിൽ നിന്നോ",
        "ta": "நான் அறியாமையாக நடப்பதிலிருந்தோ என்னிடம் அவ்வாறு நடக்கப்படுவதிலிருந்தோ"
      }
    },
    {
      "start": "00:00:21,098",
      "end": "00:00:23,093",
      "text": {
        "ar": "عَلَيَّ اللَّهُمَّ إِنِّي",
        "tl": "alayya Allahumma inni",
        "ms": "Ke atasku. Ya Allah sesungguhnya aku",
        "en": "O Allah, indeed I",
        "ml": "അല്ലാഹുവേ, തീർച്ചയായും ഞാൻ",
        "ta": "யா அல்லாஹ், நிச்சயமாக நான்"
      }
    },
    {
      "start": "00:00:23,093",
      "end": "00:00:24,813",
      "text": {
        "ar": "لَمْ أَخْرُجْ أَشَرًا",
        "tl": "lam akhruj asharan",
        "ms": "Tidaklah aku keluar kerana sombong",
        "en": "Did not go out for pride",
        "ml": "അഹങ്കാരത്തോടെയോ ഗർവ്വോടെയോ അല്ല പുറപ്പെട്ടത്",
        "ta": "பெருமைக் கொண்டு நான் புறப்படவில்லை"
      }
    },
    {
      "start": "00:00:24,836",
      "end": "00:00:26,189",
      "text": {
        "ar": "وَ لَا بَطَرًا",
        "tl": "wa la bataran",
        "ms": "Atau angkuh",
        "en": "Nor for arrogance",
        "ml": "ആരെയും കാണിക്കാനോ കേൾപ്പിക്കാനോ അല്ല",
        "ta": "ஆணவத்துடனோ"
      }
    },
    {
      "start": "00:00:26,189",
      "end": "00:00:29,308",
      "text": {
        "ar": "وَ لَا رِيَاءً وَ لَا سُمْعَةً",
        "tl": "wa la riya'an wa la sum'atan",
        "ms": "Atau riyak atau mencari kemasyhuran",
        "en": "Nor for show or reputation",
        "ml": "മറിച്ച് ഞാൻ പുറപ്പെട്ടത്",
        "ta": "பிறர் பார்க்கவோ பிறர் புகழவோ அல்ல"
      }
    },
    {
      "start": "00:00:29,354",
      "end": "00:00:29,927",
      "text": {
        "ar": "بَلْ خَرَجْتُ",
        "tl": "bal kharajtu",
        "ms": "Bahkan aku keluar",
        "en": "But I went out",
        "ml": "നിന്റെ കോപത്തെ ഭയന്നും",
        "ta": "மாறாக நான் புறப்பட்டதெல்லாம்"
      }
    },
    {
      "start": "00:00:29,973",
      "end": "00:00:31,602",
      "text": {
        "ar": "اتِّقَاءَ سَخَطِكَ",
        "tl": "ittiqa'a sakhatika",
        "ms": "Kerana takut akan kemurkaan-Mu",
        "en": "To avoid Your wrath",
        "ml": "നിന്റെ നിർബന്ധ ബാധ്യത നിറവേറ്റാനും",
        "ta": "உன் கோபத்தைப் பயந்தும்"
      }
    },
    {
      "start": "00:00:31,625",
      "end": "00:00:33,500",
      "text": {
        "ar": "وَ قَضَاءَ فَرْضِكَ",
        "tl": "wa qada'a fardika",
        "ms": "Dan menunaikan kewajipan-Mu",
        "en": "And to fulfill Your obligation",
        "ml": "നിന്റെ പ്രവാചകന്റെ ചര്യ പിന്തുടരാനും",
        "ta": "உன் கடமையை நிறைவேற்றவும்"
      }
    },
    {
      "start": "00:00:33,500",
      "end": "00:00:35,775",
      "text": {
        "ar": "وَ اتِّبَاعَ سُنَّةِ نَبِيِّكَ",
        "tl": "wattiba'a sunnati nabiyyika",
        "ms": "Dan mengikut sunnah Nabi-Mu",
        "en": "And to follow the Sunnah of Your Prophet",
        "ml": "നിന്നെ കാണാനുള്ള ആഗ്രഹം കൊണ്ടുമാണ്",
        "ta": "உன் நபியின் வழியைப் பின்பற்றவும்"
      }
    },
    {
      "start": "00:00:35,775",
      "end": "00:00:39,000",
      "text": {
        "ar": "وَ شَوْقًا إِلَى لِقَاءِكَ",
        "tl": "wa shawqan ila liqa'ika",
        "ms": "Serta rindu untuk menemui-Mu",
        "en": "And out of longing to meet You",
        "ta": "உன்னைச் சந்திக்கும் ஆவலுடனும்"
      }
    }
  ]
}