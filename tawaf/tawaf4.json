{
  "file_name": "tawaf4.mp3",
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:01,112",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:01,022",
      "end": "00:00:02,646",
      "text": {
        "ar": "اجْعَلْ هَذِهِ الْعُمْرَةَ",
        "tl": "ij'al hadhihil 'umrata",
        "ms": "Jadikanlah umrah ini",
        "en": "Make this Umrah",
        "ml": "ഈ ഉംറയെ നീ ആക്കേണമേ",
        "ta": "இந்த உம்ராவை ஆக்குவாயாக"
      }
    },
    {
      "start": "00:00:02,677",
      "end": "00:00:04,211",
      "text": {
        "ar": "عُمْرَةً مَقْبُولَةً",
        "tl": "'umratan maqbulatan",
        "ms": "Umrah yang mabrur",
        "en": "An accepted Umrah",
        "ml": "സ്വീകരിക്കപ്പെട്ട ഉംറ",
        "ta": "ஒப்புக்கொள்ளப்பட்ட உம்ராவாக"
      }
    },
    {
      "start": "00:00:04,271",
      "end": "00:00:06,406",
      "text": {
        "ar": "وَسَعْيًا مَشْكُورًا",
        "tl": "wa sa'yan mashkuran",
        "ms": "Dan usaha yang diterima",
        "en": "And a recognized effort",
        "ml": "നന്ദി അറിയിക്കപ്പെട്ട പരിശ്രമം",
        "ta": "நன்றி கூறப்பட்ட முயற்சியாக"
      }
    },
    {
      "start": "00:00:06,406",
      "end": "00:00:08,061",
      "text": {
        "ar": "وَذَنْبًا مَغْفُورًا",
        "tl": "wa dhanban maghfuran",
        "ms": "Dan dosa yang diampunkan",
        "en": "And a forgiven sin",
        "ml": "പൊറുക്കപ്പെട്ട പാപം",
        "ta": "மன்னிக்கப்பட்ட பாவமாக"
      }
    },
    {
      "start": "00:00:08,211",
      "end": "00:00:10,527",
      "text": {
        "ar": "وَعَمَلًا صَالِحًا مَقْبُولًا",
        "tl": "wa 'amalan salihan maqbulan",
        "ms": "Dan amal soleh yang maqbul",
        "en": "And an accepted righteous deed",
        "ml": "സ്വീകരിക്കപ്പെട്ട സൽക്കർമ്മം",
        "ta": "ஏற்கப்பட்ட நற்செயலாக"
      }
    },
    {
      "start": "00:00:10,497",
      "end": "00:00:12,663",
      "text": {
        "ar": "وَتِجَارَةً لَنْ تَبُورَ",
        "tl": "wa tijaratan lan tabur",
        "ms": "Dan perdagangan yang tidak akan rugi",
        "en": "And a trade that will never perish",
        "ml": "ഒരിക്കലും നഷ്ടപ്പെടാത്ത കച്ചവടം",
        "ta": "அழிவற்ற வியாபாரமாக"
      }
    },
    {
      "start": "00:00:12,663",
      "end": "00:00:15,851",
      "text": {
        "ar": "يَا عَالِمَ مَا فِي الصُّدُورِ",
        "tl": "ya 'alima ma fis-sudur",
        "ms": "Wahai Tuhan yang mengetahui isi hati",
        "en": "O Knower of what is in the hearts",
        "ml": "ഹൃദയങ്ങളിലുള്ളത് അറിയുന്നവനേ",
        "ta": "உள்ளங்களில் உள்ளதை அறிபவனே"
      }
    },
    {
      "start": "00:00:15,851",
      "end": "00:00:18,137",
      "text": {
        "ar": "أَخْرِجْنِي يَا اللهُ",
        "tl": "akhrijni ya Allah",
        "ms": "Keluarkanlah aku ya Allah",
        "en": "Bring me out, O Allah",
        "ml": "എന്നെ നീ പുറത്തുകൊണ്ടുവരേണമേ",
        "ta": "என்னை வெளியேற்றுவாயாக யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:18,137",
      "end": "00:00:20,664",
      "text": {
        "ar": "مِنَ الظُّلُمَاتِ إِلَى النُّورِ",
        "tl": "minaz-zulumati ilan-nur",
        "ms": "Dari kegelapan kepada cahaya",
        "en": "From darkness into light",
        "ml": "ഇരുളുകളിൽ നിന്നും വെളിച്ചത്തിലേക്ക്",
        "ta": "இருள்களிலிருந்து ஒளியின் பக்கம்"
      }
    },
    {
      "start": "00:00:20,634",
      "end": "00:00:22,439",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:22,439",
      "end": "00:00:23,943",
      "text": {
        "ar": "إِنِّي أَسْأَلُكَ",
        "tl": "inni as'aluka",
        "ms": "Sesungguhnya aku memohon kepada-Mu",
        "en": "I ask You for",
        "ml": "ഞാൻ നിന്നോട് ചോദിക്കുന്നു",
        "ta": "நிச்சயமாக நான் உன்னிடம் கேட்கிறேன்"
      }
    },
    {
      "start": "00:00:23,943",
      "end": "00:00:25,657",
      "text": {
        "ar": "مُوجِبَاتِ رَحْمَتِكَ",
        "tl": "mujibati rahmatika",
        "ms": "Rahmat yang mewajibkan syurga",
        "en": "The causes of Your mercy",
        "ml": "നിന്റെ കാരുണ്യത്തിന് കാരണമാകുന്നവ",
        "ta": "உன் அருளைப் பெற்றுத் தருபவை"
      }
    },
    {
      "start": "00:00:25,657",
      "end": "00:00:28,003",
      "text": {
        "ar": "وَعَزَائِمَ مَغْفِرَتِكَ",
        "tl": "wa 'azaima maghfiratika",
        "ms": "Dan keampunan yang pasti",
        "en": "And the certainty of Your forgiveness",
        "ml": "നിന്റെ പാപമോചനത്തിനുള്ള ഉറപ്പുകൾ",
        "ta": "உன் மன்னிப்பை உறுதி செய்பவை"
      }
    },
    {
      "start": "00:00:27,943",
      "end": "00:00:30,590",
      "text": {
        "ar": "وَالسَّلَامَةَ مِنْ كُلِّ إِثْمٍ",
        "tl": "was-salamata min kulli ithm",
        "ms": "Dan terpelihara dari segala dosa",
        "en": "And safety from every sin",
        "ml": "എല്ലാ പാപങ്ങളിൽ നിന്നുമുള്ള സുരക്ഷ",
        "ta": "ஒவ்வொரு பாவத்திலிருந்தும் பாதுகாப்பு"
      }
    },
    {
      "start": "00:00:30,560",
      "end": "00:00:33,358",
      "text": {
        "ar": "وَالْغَنِيمَةَ مِنْ كُلِّ بِرٍّ",
        "tl": "wal-ghanimata min kulli birr",
        "ms": "Dan beroleh segala kebaikan",
        "en": "And the gain of every virtue",
        "ml": "എല്ലാ പുണ്യപ്രവൃത്തികളുടെയും നേട്ടം",
        "ta": "ஒவ்வொரு நன்மையின் பலன்"
      }
    },
    {
      "start": "00:00:33,328",
      "end": "00:00:35,463",
      "text": {
        "ar": "وَالْفَوْزَ بِالْجَنَّةِ",
        "tl": "wal-fawza bil-jannah",
        "ms": "Dan kemenangan mendapat syurga",
        "en": "And the victory of Paradise",
        "ml": "സ്വർഗ്ഗലബ്ധിയായ വിജയം",
        "ta": "சுவனத்தின் வெற்றி"
      }
    },
    {
      "start": "00:00:35,433",
      "end": "00:00:37,689",
      "text": {
        "ar": "وَالنَّجَاةَ مِنَ النَّارِ",
        "tl": "wan-najata minan-nar",
        "ms": "Dan terselamat dari api neraka",
        "en": "And salvation from the Fire",
        "ml": "നരകത്തിൽ നിന്നുള്ള രക്ഷ",
        "ta": "நரகத்திலிருந்து விடுதலை"
      }
    },
    {
      "start": "00:00:37,809",
      "end": "00:00:41,269",
      "text": {
        "ar": "رَبِّ قَنِّعْنِي بِمَا رَزَقْتَنِي",
        "tl": "rabbi qanni'ni bima razaqtani",
        "ms": "Wahai Tuhanku, jadikanlah aku merasa cukup dengan rezeki yang Engkau berikan",
        "en": "My Lord, make me content with what You have provided me",
        "ml": "എന്റെ നാഥാ, നീ എനിക്ക് നൽകിയതിൽ എന്നെ സംതൃപ്തനാക്കേണമേ",
        "ta": "என் இறைவா, நீ எனக்கு வழங்கியதைக் கொண்டு என்னைத் திருப்திப்படுத்து"
      }
    },
    {
      "start": "00:00:41,238",
      "end": "00:00:44,547",
      "text": {
        "ar": "وَبَارِكْ لِي فِيمَا أَعْطَيْتَنِي",
        "tl": "wa barik li fima a'taytani",
        "ms": "Dan berkatilah aku pada apa yang Engkau kurniakan",
        "en": "And bless me in what You have given me",
        "ml": "നീ എനിക്ക് നൽകിയതിൽ അനുഗ്രഹം നൽകേണമേ",
        "ta": "நீ எனக்குக் கொடுத்தவற்றில் பரகத் செய்"
      }
    },
    {
      "start": "00:00:44,457",
      "end": "00:00:46,111",
      "text": {
        "ar": "وَاخْلُفْ عَلَيَّ",
        "tl": "wakhluf 'alayya",
        "ms": "Dan gantikanlah bagiku",
        "en": "And replace for me",
        "ml": "എനിക്ക് പകരമായി നൽകേണമേ",
        "ta": "எனக்குப் பகரமாகத் தருவாயாக"
      }
    },
    {
      "start": "00:00:46,051",
      "end": "00:00:47,796",
      "text": {
        "ar": "كُلَّ غَائِبَةٍ لِي",
        "tl": "kulla gha'ibatin li",
        "ms": "Segala yang hilang dariku",
        "en": "Everything I have lost",
        "ml": "എനിക്ക് നഷ്ടപ്പെട്ടവയ്ക്കെല്ലാം",
        "ta": "எனக்குத் தவறிப்போன எல்லாவற்றிற்கும்"
      }
    },
    {
      "start": "00:00:47,766",
      "end": "00:00:49,119",
      "text": {
        "ar": "مِنْكَ بِخَيْرٍ",
        "tl": "minka bikhayr",
        "ms": "Dengan kebaikan daripada-Mu",
        "en": "With good from You",
        "ml": "നിന്നിൽ നിന്നുള്ള നന്മ കൊണ്ട്",
        "ta": "உன்னிடமிருந்து சிறந்த நன்மையைக் கொண்டு"
      }
    }
  ]
}