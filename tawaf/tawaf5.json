{
  "file_name": "tawaf5.mp3",
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:01,165",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:01,165",
      "end": "00:00:03,284",
      "text": {
        "ar": "أَظِلَّنِي تَحْتَ ظِلِّ عَرْشِكَ",
        "tl": "azhillani tahta zhilli 'arshika",
        "ms": "Lindungilah aku di bawah naungan Arasy-Mu",
        "en": "Shade me under the shade of Your Throne",
        "ml": "നിന്റെ അർശിന്റെ തണലിൽ എനിക്ക് തണലേകേണമേ",
        "ta": "உன் அர்ஷின் நிழலில் எனக்கு நிழல் தருவாயாக"
      }
    },
    {
      "start": "00:00:03,284",
      "end": "00:00:06,322",
      "text": {
        "ar": "يَوْمَ لَا ظِلَّ إِلَّا ظِلُّكَ",
        "tl": "yawma la zhilla illa zhilluka",
        "ms": "Pada hari yang tiada naungan melainkan naungan-Mu",
        "en": "On the day when there is no shade but Your shade",
        "ml": "നിന്റെ തണലല്ലാതെ മറ്റൊരു തണലുമില്ലാത്ത ആ ദിവസം",
        "ta": "உன் நிழலைத் தவிர வேறு நிழல் இல்லாத அந்த நாளில்"
      }
    },
    {
      "start": "00:00:06,322",
      "end": "00:00:09,148",
      "text": {
        "ar": "وَلَا بَاقِيَ إِلَّا وَجْهُكَ",
        "tl": "wa la baqiya illa wajhuka",
        "ms": "Dan tiada yang kekal melainkan Zat-Mu",
        "en": "And nothing remains but Your Face",
        "ml": "നിന്റെ മുഖമല്ലാതെ മറ്റൊന്നും അവശേഷിക്കാത്ത ദിവസം",
        "ta": "உன் திருமுகத்தைத் தவிர வேறு எதுவும் நிலைத்திராத நாளில்"
      }
    },
    {
      "start": "00:00:09,148",
      "end": "00:00:11,938",
      "text": {
        "ar": "وَاسْقِنِي مِنْ حَوْضِ نَبِيِّكَ",
        "tl": "wasqini min hawzhi nabiyyika",
        "ms": "Dan berilah aku minum dari kolam Nabi-Mu",
        "en": "And give me to drink from the Cistern of Your Prophet",
        "ml": "നിന്റെ പ്രവാചകന്റെ ഹൗളിൽ നിന്നും എനിക്ക് കുടിപ്പിക്കേണമേ",
        "ta": "உன் நபியின் ஹவ்ளிலிருந்து எனக்குப் புகட்டுவாயாக"
      }
    },
    {
      "start": "00:00:11,867",
      "end": "00:00:15,541",
      "text": {
        "ar": "مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ",
        "tl": "Muhammadin sallallahu 'alayhi wa sallam",
        "ms": "Muhammad SAW",
        "en": "Muhammad, peace and blessings be upon him",
        "ml": "മുഹമ്മദ് നബി (സ) യുടെ ഹൗളിൽ നിന്ന്",
        "ta": "முஹம்மது (ஸல்) அவர்களின் ஹவ்ளிலிருந்து"
      }
    },
    {
      "start": "00:00:15,576",
      "end": "00:00:17,837",
      "text": {
        "ar": "شَرْبَةً هَنِيئَةً",
        "tl": "sharbatan hani'atan",
        "ms": "Dengan minuman yang lazat",
        "en": "A pleasant, delicious drink",
        "ml": "രുചികരമായ ഒരു പാനീയം",
        "ta": "சுவையான ஒரு பானத்தை"
      }
    },
    {
      "start": "00:00:17,801",
      "end": "00:00:20,592",
      "text": {
        "ar": "لَا نَظْمَأُ بَعْدَهَا أَبَدًا",
        "tl": "la nazhma'u ba'daha abada",
        "ms": "Yang kami tidak akan dahaga selepasnya buat selama-lamanya",
        "en": "After which we will never feel thirst again",
        "ml": "അതിന് ശേഷം ഒരിക്കലും ദാഹിക്കാത്ത വിധം",
        "ta": "அதன் பின் எக்காலமும் நாங்கள் தாகிக்காதவாறு"
      }
    },
    {
      "start": "00:00:20,627",
      "end": "00:00:21,581",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:21,546",
      "end": "00:00:23,135",
      "text": {
        "ar": "إِنِّي أَسْأَلُكَ",
        "tl": "inni as'aluka",
        "ms": "Sesungguhnya aku memohon kepada-Mu",
        "en": "Indeed, I ask You",
        "ml": "ഞാൻ നിന്നോട് ചോദിക്കുന്നു",
        "ta": "நிச்சயமாக நான் உன்னிடம் கேட்கிறேன்"
      }
    },
    {
      "start": "00:00:23,064",
      "end": "00:00:25,078",
      "text": {
        "ar": "مِنْ خَيْرِ مَا سَأَلَكَ مِنْهُ",
        "tl": "min khayri ma sa'alaka minhu",
        "ms": "Segala kebaikan yang pernah dipohon oleh",
        "en": "For the best of what was asked of You by",
        "ml": "നിന്നോട് ചോദിച്ചതിൽ വെച്ച് ഏറ്റവും ഉത്തമമായത്",
        "ta": "உன்னிடம் கேட்கப்பட்டவற்றில் மிகச் சிறந்ததை"
      }
    },
    {
      "start": "00:00:25,042",
      "end": "00:00:26,102",
      "text": {
        "ar": "نَبِيُّكَ مُحَمَّدٌ",
        "tl": "nabiyyuka Muhammadun",
        "ms": "Nabi-Mu Muhammad",
        "en": "Your Prophet Muhammad",
        "ml": "നിന്റെ പ്രവാചകൻ മുഹമ്മദ് നബി (സ)",
        "ta": "உன் நபி முஹம்மது (ஸல்) அவர்கள்"
      }
    },
    {
      "start": "00:00:26,455",
      "end": "00:00:29,246",
      "text": {
        "ar": "صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ",
        "tl": "sallallahu 'alayhi wa sallam",
        "ms": "Selawat dan salam ke atasnya",
        "en": "Peace and blessings be upon him",
        "ml": "അവിടുത്തെ മേൽ അല്ലാഹുവിന്റെ രക്ഷയും സമാധാനവും ഉണ്ടാകട്ടെ",
        "ta": "அவர் மீது அல்லாஹ்வின் அருளும் சாந்தியும் உண்டாகட்டும்"
      }
    },
    {
      "start": "00:00:29,422",
      "end": "00:00:30,800",
      "text": {
        "ar": "وَأَعُوذُ بِكَ",
        "tl": "wa a'udhu bika",
        "ms": "Dan aku berlindung dengan-Mu",
        "en": "And I seek refuge in You",
        "ml": "ഞാൻ നിന്നോട് കാവൽ തേടുന്നു",
        "ta": "மேலும் உன்னிடம் பாதுகாப்புத் தேடுகிறேன்"
      }
    },
    {
      "start": "00:00:30,800",
      "end": "00:00:33,131",
      "text": {
        "ar": "مِنْ شَرِّ مَا اسْتَعَاذَكَ مِنْهُ",
        "tl": "min sharri masta'adhaka minhu",
        "ms": "Dari kejahatan yang pernah dipohon perlindungan oleh",
        "en": "From the evil from which refuge was sought by",
        "ml": "ഏതൊരു തിന്മയിൽ നിന്നാണോ കാവൽ തേടിയത്",
        "ta": "எந்தத் தீங்கிலிருந்து பாதுகாப்புத் தேடினார்களோ"
      }
    },
    {
      "start": "00:00:33,166",
      "end": "00:00:35,003",
      "text": {
        "ar": "نَبِيُّكَ مُحَمَّدٌ",
        "tl": "nabiyyuka Muhammadun",
        "ms": "Nabi-Mu Muhammad",
        "en": "Your Prophet Muhammad",
        "ml": "നിന്റെ പ്രവാചകൻ മുഹമ്മദ് നബി (സ)",
        "ta": "உன் நபி முஹம்மது (ஸல்) அவர்கள்"
      }
    },
    {
      "start": "00:00:35,003",
      "end": "00:00:38,182",
      "text": {
        "ar": "صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ",
        "tl": "sallallahu 'alayhi wa sallam",
        "ms": "Selawat dan salam ke atasnya",
        "en": "Peace and blessings be upon him",
        "ml": "അവിടുത്തെ മേൽ അല്ലാഹുവിന്റെ രക്ഷയും സമാധാനവും ഉണ്ടാകട്ടെ",
        "ta": "அவர் மீது அல்லாஹ்வின் அருளும் சாந்தியும் உண்டாகட்டும்"
      }
    },
    {
      "start": "00:00:38,253",
      "end": "00:00:40,866",
      "text": {
        "ar": "اللَّهُمَّ إِنِّي أَسْأَلُكَ الْجَنَّةَ",
        "tl": "Allahumma inni as'alukal-jannah",
        "ms": "Ya Allah, aku memohon kepada-Mu syurga",
        "en": "O Allah, I ask You for Paradise",
        "ml": "അല്ലാഹുവേ, ഞാൻ നിന്നോട് സ്വർഗ്ഗത്തെ ചോദിക്കുന്നു",
        "ta": "யா அல்லாஹ், உன்னிடம் சுவனத்தை வேண்டுகிறேன்"
      }
    },
    {
      "start": "00:00:40,831",
      "end": "00:00:42,809",
      "text": {
        "ar": "وَنَعِيمَهَا",
        "tl": "wa na'imaha",
        "ms": "Dan segala nikmatnya",
        "en": "And its bliss",
        "ml": "അതിലെ അനുഗ്രഹങ്ങളെയും",
        "ta": "அதன் இன்பங்களையும்"
      }
    },
    {
      "start": "00:00:42,809",
      "end": "00:00:45,529",
      "text": {
        "ar": "وَمَا يُقَرِّبُنِي إِلَيْهَا",
        "tl": "wa ma yuqarribuni ilayha",
        "ms": "Serta apa yang boleh mendekatkan aku kepadanya",
        "en": "And what brings me closer to it",
        "ml": "അതിലേക്ക് എന്നെ അടുപ്പിക്കുന്നവയെയും",
        "ta": "என்னை அதன் பக்கம் நெருக்கமாக்குபவற்றையும்"
      }
    },
    {
      "start": "00:00:45,529",
      "end": "00:00:49,555",
      "text": {
        "ar": "مِنْ قَوْلٍ أَوْ فِعْلٍ أَوْ عَمَلٍ",
        "tl": "min qawlin aw fi'lin aw 'amal",
        "ms": "Sama ada perkataan, perbuatan atau amalan",
        "en": "Of speech, action, or deed",
        "ml": "വാക്കുകളോ പ്രവൃത്തികളോ കർമ്മങ്ങളോ ആകട്ടെ",
        "ta": "சொல்லால், செயலால் அல்லது அமலால்"
      }
    },
    {
      "start": "00:00:49,661",
      "end": "00:00:51,816",
      "text": {
        "ar": "وَأَعُوذُ بِكَ مِنَ النَّارِ",
        "tl": "wa a'udhu bika minan-nar",
        "ms": "Dan aku berlindung dengan-Mu dari neraka",
        "en": "And I seek refuge in You from the Fire",
        "ml": "നരകത്തിൽ നിന്നും ഞാൻ നിന്നോട് കാവൽ തേടുന്നു",
        "ta": "நரகத்தை விட்டும் உன்னிடம் பாதுகாப்புத் தேடுகிறேன்"
      }
    },
    {
      "start": "00:00:52,240",
      "end": "00:00:54,606",
      "text": {
        "ar": "وَمَا يُقَرِّبُنِي إِلَيْهَا",
        "tl": "wa ma yuqarribuni ilayha",
        "ms": "Serta apa yang boleh mendekatkan aku kepadanya",
        "en": "And what brings me closer to it",
        "ml": "അതിലേക്ക് എന്നെ അടുപ്പിക്കുന്നവയിൽ നിന്നും",
        "ta": "என்னை அதன் பக்கம் நெருக்கமாக்குபவற்றிலிருந்தும்"
      }
    },
    {
      "start": "00:00:54,606",
      "end": "00:05:08,350",
      "text": {
        "ar": "مِنْ قَوْلٍ أَوْ فِعْلٍ أَوْ عَمَلٍ",
        "tl": "min qawlin aw fi'lin aw 'amal",
        "ms": "Sama ada perkataan, perbuatan atau amalan",
        "en": "Of speech, action, or deed",
        "ml": "വാക്കുകളോ പ്രവൃത്തികളോ കർമ്മങ്ങളോ ആകട്ടെ",
        "ta": "சொல்லால், செயலால் அல்லது அமலால்"
      }
    }
  ]
}