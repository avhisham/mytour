{
  "file_name": "tawaf3.mp3",
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:01,200",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:01,200",
      "end": "00:00:02,692",
      "text": {
        "ar": "إِنِّي أَعُوذُ بِكَ",
        "tl": "inni a'udhu bika",
        "ms": "Sesungguhnya aku berlindung dengan-Mu",
        "en": "I seek refuge in You",
        "ml": "ഞാൻ നിന്നോട് കാവൽ തേടുന്നു",
        "ta": "நிச்சயமாக நான் உன்னிடம் பாதுகாப்புத் தேடுகிறேன்"
      }
    },
    {
      "start": "00:00:02,710",
      "end": "00:00:05,720",
      "text": {
        "ar": "مِنَ الشَّكِّ وَالشِّرْكِ",
        "tl": "minash-shakki wash-shirk",
        "ms": "Daripada ragu-ragu dan syirik",
        "en": "From doubt and shirk",
        "ml": "സംശയത്തിൽ നിന്നും ശിർക്കിൽ നിന്നും",
        "ta": "சந்தேகத்திலிருந்தும் இணைவைப்பிலிருந்தும்"
      }
    },
    {
      "start": "00:00:05,683",
      "end": "00:00:08,562",
      "text": {
        "ar": "وَالشِّقَاقِ وَالنِّفَاقِ",
        "tl": "wash-shiqaqi wan-nifaq",
        "ms": "Perbalahan dan nifaq",
        "en": "Discord and hypocrisy",
        "ml": "പിണക്കത്തിൽ നിന്നും കാപട്യത്തിൽ നിന്നും",
        "ta": "பிணக்கிலிருந்தும் நயவஞ்சகத்திலிருந்தும்"
      }
    },
    {
      "start": "00:00:08,599",
      "end": "00:00:10,132",
      "text": {
        "ar": "وَسُوءِ الْأَخْلَاقِ",
        "tl": "wa su'il-akhlaq",
        "ms": "Dan buruk akhlak",
        "en": "And bad character",
        "ml": "ദുസ്വഭാവത്തിൽ നിന്നും",
        "ta": "தீய குணத்திலிருந்தும்"
      }
    },
    {
      "start": "00:00:10,170",
      "end": "00:00:11,646",
      "text": {
        "ar": "وَسُوءِ الْمَنْظَرِ",
        "tl": "wa su'il-manzhari",
        "ms": "Dan buruk pemandangan",
        "en": "And an ill appearance",
        "ml": "മോശമായ കാഴ്ചയിൽ നിന്നും",
        "ta": "கெட்ட தோற்றத்திலிருந்தும்"
      }
    },
    {
      "start": "00:00:11,684",
      "end": "00:00:12,413",
      "text": {
        "ar": "وَالْمُنْقَلَبِ",
        "tl": "wal-munqalab",
        "ms": "Dan kepulangan yang buruk",
        "en": "And an evil return",
        "ml": "തിരിച്ചുവരവിൽ നിന്നും",
        "ta": "கெட்ட மாற்றத்திலிருந்தும்"
      }
    },
    {
      "start": "00:00:12,432",
      "end": "00:00:13,591",
      "text": {
        "ar": "فِي الْمَالِ",
        "tl": "fil-mali",
        "ms": "Pada harta benda",
        "en": "In wealth",
        "ml": "സമ്പത്തിലും",
        "ta": "செல்வத்திலும்"
      }
    },
    {
      "start": "00:00:13,591",
      "end": "00:00:16,470",
      "text": {
        "ar": "وَالْأَهْلِ وَالْوَلَدِ",
        "tl": "wal-ahli wal-walad",
        "ms": "Keluarga dan anak-anak",
        "en": "Family and children",
        "ml": "കുടുംബത്തിലും സന്താനങ്ങളിലും",
        "ta": "குடும்பத்திலும் பிள்ளைகளிலும்"
      }
    },
    {
      "start": "00:00:16,582",
      "end": "00:00:17,143",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:17,068",
      "end": "00:00:18,657",
      "text": {
        "ar": "إِنِّي أَسْأَلُكَ",
        "tl": "inni as'aluka",
        "ms": "Sesungguhnya aku memohon kepada-Mu",
        "en": "I ask You for",
        "ml": "ഞാൻ നിന്നോട് ചോദിക്കുന്നു",
        "ta": "நிச்சயமாக நான் உன்னிடம் கேட்கிறேன்"
      }
    },
    {
      "start": "00:00:18,657",
      "end": "00:00:20,975",
      "text": {
        "ar": "رِضَاكَ وَالْجَنَّةَ",
        "tl": "ridhaka wal-jannah",
        "ms": "Keredaan-Mu dan syurga",
        "en": "Your pleasure and Paradise",
        "ml": "നിന്റെ പ്രീതിയും സ്വർഗ്ഗവും",
        "ta": "உன் பொருத்தத்தையும் சுவனத்தையும்"
      }
    },
    {
      "start": "00:00:20,956",
      "end": "00:00:22,415",
      "text": {
        "ar": "وَأَعُوذُ بِكَ",
        "tl": "wa a'udhu bika",
        "ms": "Dan aku berlindung dengan-Mu",
        "en": "And I seek refuge in You",
        "ml": "ഞാൻ നിന്നോട് കാവൽ തേടുന്നു",
        "ta": "மேலும் உன்னிடம் பாதுகாப்புத் தேடுகிறேன்"
      }
    },
    {
      "start": "00:00:22,452",
      "end": "00:00:24,733",
      "text": {
        "ar": "مِنْ سَخَطِكَ وَالنَّارِ",
        "tl": "min sakhatika wan-nar",
        "ms": "Daripada kemurkaan-Mu dan neraka",
        "en": "From Your wrath and the Fire",
        "ml": "നിന്റെ കോപത്തിൽ നിന്നും നരകത്തിൽ നിന്നും",
        "ta": "உன் கோபத்திலிருந்தும் நரகத்திலிருந்தும்"
      }
    },
    {
      "start": "00:00:24,920",
      "end": "00:00:25,481",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:25,462",
      "end": "00:00:27,257",
      "text": {
        "ar": "إِنِّي أَعُوذُ بِكَ",
        "tl": "inni a'udhu bika",
        "ms": "Sesungguhnya aku berlindung dengan-Mu",
        "en": "I seek refuge in You",
        "ml": "ഞാൻ നിന്നോട് കാവൽ തേടുന്നു",
        "ta": "நிச்சயமாக நான் உன்னிடம் பாதுகாப்புத் தேடுகிறேன்"
      }
    },
    {
      "start": "00:00:27,257",
      "end": "00:00:29,145",
      "text": {
        "ar": "مِنْ فِتْنَةِ الْقَبْرِ",
        "tl": "min fitnatil-qabr",
        "ms": "Daripada fitnah kubur",
        "en": "From the trial of the grave",
        "ml": "ഖബറിലെ പരീക്ഷണത്തിൽ നിന്നും",
        "ta": "மண்ணறையின் சோதனையிலிருந்தும்"
      }
    },
    {
      "start": "00:00:29,182",
      "end": "00:00:30,603",
      "text": {
        "ar": "وَ مِنْ فِتْنَةِ الْمَحْيَا",
        "tl": "wa min fitnatil-mahya",
        "ms": "Dan daripada fitnah kehidupan",
        "en": "And from the trials of life",
        "ml": "ജീവിതത്തിലെ പരീക്ഷണങ്ങളിൽ നിന്നും",
        "ta": "வாழ்வின் சோதனையிலிருந்தும்"
      }
    },
    {
      "start": "00:00:30,584",
      "end": "00:00:31,800",
      "text": {
        "ar": "وَالْمَمَاتِ",
        "tl": "wal-mamat",
        "ms": "Serta kematian",
        "en": "And death",
        "ml": "മരണത്തിലെ പരീക്ഷണങ്ങളിൽ നിന്നും",
        "ta": "மரணத்தின் சோதனையிலிருந்தும்"
      }
    }
  ]
