{
  "file_name": "tawaf6.mp3",
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:01,500",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:01,500",
      "end": "00:00:02,959",
      "text": {
        "ar": "إِنَّ لَكَ عَلَيَّ",
        "tl": "inna laka 'alayya",
        "ms": "Sesungguhnya Engkau mempunyai",
        "en": "Indeed, You have over me",
        "ml": "നിനക്ക് എന്റെ മേൽ ഉണ്ട്",
        "ta": "நிச்சயமாக உனக்கு என் மீது"
      }
    },
    {
      "start": "00:00:02,931",
      "end": "00:00:04,673",
      "text": {
        "ar": "حُقُوقًا كَثِيرَةً",
        "tl": "huquqan kathiratan",
        "ms": "Hak-hak yang banyak ke atasku",
        "en": "Many rights",
        "ml": "ധാരാളം അവകാശങ്ങൾ",
        "ta": "ஏராளமான கடமைகள் உள்ளன"
      }
    },
    {
      "start": "00:00:04,646",
      "end": "00:00:06,941",
      "text": {
        "ar": "فِيمَا بَيْنِي وَبَيْنَكَ",
        "tl": "fima bayni wa baynaka",
        "ms": "Dalam hubungan antara aku dengan-Mu",
        "en": "Between me and You",
        "ml": "എനിക്കും നിനക്കും ഇടയിലുള്ള കാര്യങ്ങളിൽ",
        "ta": "எனக்கும் உனக்கும் இடையில் உள்ளவற்றில்"
      }
    },
    {
      "start": "00:00:06,914",
      "end": "00:00:09,071",
      "text": {
        "ar": "وَحُقُوقًا كَثِيرَةً",
        "tl": "wa huquqan kathiratan",
        "ms": "Dan hak-hak yang banyak",
        "en": "And many rights",
        "ml": "ധാരാളം അവകാശങ്ങൾ",
        "ta": "ஏராளமான கடமைகள் உள்ளன"
      }
    },
    {
      "start": "00:00:09,071",
      "end": "00:00:12,390",
      "text": {
        "ar": "فِيمَا بَيْنِي وَبَيْنَ خَلْقِكَ",
        "tl": "fima bayni wa bayna khalqika",
        "ms": "Dalam hubungan antara aku dengan makhluk-Mu",
        "en": "Between me and Your creation",
        "ml": "എനിക്കും നിന്റെ സൃഷ്ടികൾക്കും ഇടയിലുള്ള കാര്യങ്ങളിൽ",
        "ta": "எனக்கும் உன் படைப்புகளுக்கும் இடையில் உள்ளவற்றில்"
      }
    },
    {
      "start": "00:00:12,390",
      "end": "00:00:13,966",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:13,966",
      "end": "00:00:15,736",
      "text": {
        "ar": "مَا كَانَ لَكَ",
        "tl": "ma kana laka",
        "ms": "Apa yang menjadi hak-Mu",
        "en": "Whatever is for You",
        "ml": "നിനക്കുള്ള അവകാശങ്ങൾ",
        "ta": "உனக்குரிய கடமைகளை"
      }
    },
    {
      "start": "00:00:15,791",
      "end": "00:00:18,087",
      "text": {
        "ar": "فَاغْفِرْهُ لِي",
        "tl": "faghfirhu li",
        "ms": "Maka ampunkanlah bagiku",
        "en": "Forgive it for me",
        "ml": "അതുകൊണ്ട് എനിക്ക് പൊറുത്തു തരേണമേ",
        "ta": "எனக்காக மன்னித்துவிடு"
      }
    },
    {
      "start": "00:00:18,087",
      "end": "00:00:20,521",
      "text": {
        "ar": "وَمَا كَانَ لِخَلْقِكَ",
        "tl": "wa ma kana likhalqika",
        "ms": "Dan apa yang menjadi hak makhluk-Mu",
        "en": "And whatever is for Your creation",
        "ml": "നിന്റെ സൃഷ്ടികൾക്കുള്ള അവകാശങ്ങൾ",
        "ta": "உன் படைப்புகளுக்குரிய கடமைகளை"
      }
    },
    {
      "start": "00:00:20,548",
      "end": "00:00:23,010",
      "text": {
        "ar": "فَتَحَمَّلْهُ عَنِّي",
        "tl": "fatahammalhu 'anni",
        "ms": "Maka tanggunglah ia dariku",
        "en": "Bear it on my behalf",
        "ml": "അത് എനിക്ക് വേണ്ടി നീ ഏറ്റെടുക്കേണമേ",
        "ta": "எனக்காக நீ பொறுப்பேற்றுக்கொள்"
      }
    },
    {
      "start": "00:00:23,010",
      "end": "00:00:25,554",
      "text": {
        "ar": "وَأَغْنِنِي بِحَلَالِكَ",
        "tl": "wa aghnini bi halalika",
        "ms": "Dan kayakanlah aku dengan rezeki yang halal",
        "en": "And enrich me with Your lawful provision",
        "ml": "ഹലാലായ വിഭവങ്ങൾ കൊണ്ട് എന്നെ ധന്യനാക്കേണമേ",
        "ta": "உன் ஹலாலான விபரங்களைக் கொண்டு என்னைப் போதுமாக்கிக் கொள்"
      }
    },
    {
      "start": "00:00:25,554",
      "end": "00:00:27,490",
      "text": {
        "ar": "عَنْ حَرَامِكَ",
        "tl": "'an haramika",
        "ms": "Daripada yang haram",
        "en": "Instead of Your unlawful",
        "ml": "ഹറാമായവയിൽ നിന്ന് (എന്നെ തടഞ്ഞുകൊണ്ട്)",
        "ta": "ஹராமானவற்றை விட்டும்"
      }
    },
    {
      "start": "00:00:27,490",
      "end": "00:03:16,113",
      "text": {
        "ar": "وَبِطَاعَتِكَ عَنْ مَعْصِيَتِكَ",
        "tl": "wa bita'atika 'an ma'siyatika",
        "ms": "Dan dengan ketaatan kepada-Mu daripada maksiat",
        "en": "And with Your obedience instead of Your disobedience",
        "ml": "നിന്റെ അനുസരണത്തിൽ എന്നെ ധന്യനാക്കേണമേ, പാപങ്ങളിൽ നിന്ന് (തടഞ്ഞുകൊണ്ട്)",
        "ta": "உன் வழிபாட்டைக் கொண்டு உன் மாறுபாட்டை விட்டும்"
      }
    },
    {
      "start": "00:00:31,611",
      "end": "00:00:34,847",
      "text": {
        "ar": "وَبِفَضْلِكَ عَمَّنْ سِوَاكَ",
        "tl": "wa bifadhlika 'amman siwaka",
        "ms": "Dan dengan kurniaan-Mu daripada selain-Mu",
        "en": "And with Your grace instead of anyone besides You",
        "ml": "നിന്റെ അനുഗ്രഹം കൊണ്ട് മറ്റാരെക്കാളും എന്നെ ധന്യനാക്കേണമേ",
        "ta": "உன் அருளைக் கொண்டு உன்னைத் தவிர மற்றவர்களை விட்டும்"
      }
    },
    {
      "start": "00:00:34,847",
      "end": "00:00:37,500",
      "text": {
        "ar": "يَا وَاسِعَ الْمَغْفِرَةِ",
        "tl": "ya wasi'al maghfirah",
        "ms": "Wahai Tuhan Yang Maha Luas pengampunan-Nya",
        "en": "O Most Vast in Forgiveness",
        "ml": "പാപമോചനത്തിൽ വിശാലതയുള്ളവനേ",
        "ta": "மன்னிப்பில் விசாலமானவனே"
      }
    },
    {
      "start": "00:00:37,500",
      "end": "00:00:39,687",
      "text": {
        "ar": "وَأَنْتَ يَا اللهُ",
        "tl": "wa anta ya Allah",
        "ms": "Dan Engkau ya Allah",
        "en": "And You, O Allah",
        "ml": "നീയാകുന്നു അല്ലാഹുവേ",
        "ta": "மேலும் நீயோ யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:39,714",
      "end": "00:00:43,558",
      "text": {
        "ar": "حَلِيمٌ كَرِيمٌ عَظِيمٌ",
        "tl": "halimun karimun 'azhimun",
        "ms": "Maha Penyantun, Maha Pemurah lagi Maha Agung",
        "en": "Are Most Clement, Generous, and Great",
        "ml": "ക്ഷമാശീലനും ഔദാര്യമുള്ളവനും മഹാനും",
        "ta": "மிகவும் சகிப்புத்தன்மை உடையவன், கண்ணியமானவன், மகத்துவமானவன்"
      }
    },
    {
      "start": "00:00:43,558",
      "end": "00:00:45,716",
      "text": {
        "ar": "تُحِبُّ الْعَفْوَ",
        "tl": "tuhibbul 'afwa",
        "ms": "Engkau sukakan kemaafan",
        "en": "You love to forgive",
        "ml": "നീ മാപ്പിനെ ഇഷ്ടപ്പെടുന്നു",
        "ta": "நீ மன்னிப்பை விரும்புகிறாய்"
      }
    },
    {
      "start": "00:00:45,688",
      "end": "00:00:47,000",
      "text": {
        "ar": "فَاعْفُ عَنِّي",
        "tl": "fa'fu 'anni",
        "ms": "Maka maafkanlah aku",
        "en": "So forgive me",
        "ml": "അതുകൊണ്ട് എനിക്ക് മാപ്പ് നൽകേണമേ",
        "ta": "எனவே என்னை மன்னித்துவிடு"
      }
    }
  ]
}