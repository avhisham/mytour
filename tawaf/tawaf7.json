{
  "file_name": "tawaf7.mp3",
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:01,500",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:01,500",
      "end": "00:00:03,500",
      "text": {
        "ar": "إِنِّي أَسْأَلُكَ",
        "tl": "inni as'aluka",
        "ms": "Sesungguhnya aku memohon kepada-Mu",
        "en": "Indeed, I ask You for",
        "ml": "ഞാൻ നിന്നോട് ചോദിക്കുന്നു",
        "ta": "நிச்சயமாக நான் உன்னிடம் வேண்டுகிறேன்"
      }
    },
    {
      "start": "00:00:03,500",
      "end": "00:00:05,500",
      "text": {
        "ar": "إِيمَانًا كَامِلًا",
        "tl": "imanan kamilan",
        "ms": "Iman yang sempurna",
        "en": "Perfect faith",
        "ml": "പരിപൂർണ്ണമായ ഈമാൻ",
        "ta": "முழுமையான ஈமானை"
      }
    },
    {
      "start": "00:00:05,500",
      "end": "00:00:07,500",
      "text": {
        "ar": "وَيَقِينًا صَادِقًا",
        "tl": "wa yaqinan sadiqan",
        "ms": "Keyakinan yang benar",
        "en": "Sincere certainty",
        "ml": "സത്യസന്ധമായ ഉറച്ച വിശ്വാസം",
        "ta": "உண்மையான உறுதியை"
      }
    },
    {
      "start": "00:00:07,500",
      "end": "00:00:09,881",
      "text": {
        "ar": "وَرِزْقًا وَاسِعًا",
        "tl": "wa rizqan wasi'an",
        "ms": "Rezeki yang luas",
        "en": "Vast provision",
        "ml": "വിശാലമായ ഉപജീവനം",
        "ta": "விசாலமான வாழ்வாதாரத்தை"
      }
    },
    {
      "start": "00:00:09,834",
      "end": "00:00:12,139",
      "text": {
        "ar": "وَقَلْبًا خَاشِعًا",
        "tl": "wa qalban khashi'an",
        "ms": "Hati yang khusyuk",
        "en": "A humble heart",
        "ml": "ഭയഭക്തിയുള്ള ഹൃദയം",
        "ta": "பணிவான உள்ளத்தை"
      }
    },
    {
      "start": "00:00:12,139",
      "end": "00:00:14,398",
      "text": {
        "ar": "وَلِسَانًا ذَاكِرًا",
        "tl": "wa lisanan dhakiran",
        "ms": "Lidah yang sentiasa berzikir",
        "en": "A tongue that remembers You",
        "ml": "നിന്നെ സ്മരിക്കുന്ന നാവ്",
        "ta": "உன்னை நினைவு கூரும் நாவை"
      }
    },
    {
      "start": "00:00:14,398",
      "end": "00:00:16,986",
      "text": {
        "ar": "وَرِزْقًا حَلَالًا طَيِّبًا",
        "tl": "wa rizqan halalan tayyiban",
        "ms": "Rezeki yang halal lagi baik",
        "en": "Lawful and good provision",
        "ml": "അനുവദനീയവും ഉത്തമവുമായ വിഭവങ്ങൾ",
        "ta": "ஹலாலான தூய்மையான உணவை"
      }
    },
    {
      "start": "00:00:16,963",
      "end": "00:00:19,386",
      "text": {
        "ar": "وَتَوْبَةً قَبْلَ الْمَوْتِ",
        "tl": "wa tawbatan qablal mawt",
        "ms": "Taubat sebelum mati",
        "en": "Repentance before death",
        "ml": "മരണത്തിന് മുമ്പുള്ള തൗബ",
        "ta": "மரணத்திற்கு முன் தவ்பாவை"
      }
    },
    {
      "start": "00:00:19,339",
      "end": "00:00:21,691",
      "text": {
        "ar": "وَمَغْفِرَةً وَرَحْمَةً",
        "tl": "wa maghfiratan wa rahmatan",
        "ms": "Keampunan dan rahmat",
        "en": "Forgiveness and mercy",
        "ml": "പാപമോചനവും കാരുണ്യവും",
        "ta": "மன்னிப்பையும் அருளையும்"
      }
    },
    {
      "start": "00:00:21,691",
      "end": "00:00:23,500",
      "text": {
        "ar": "بَعْدَ الْمَوْتِ",
        "tl": "ba'dal mawt",
        "ms": "Selepas mati",
        "en": "After death",
        "ml": "മരണത്തിന് ശേഷം",
        "ta": "மரணத்திற்குப் பின்"
      }
    },
    {
      "start": "00:00:23,500",
      "end": "00:00:26,162",
      "text": {
        "ar": "وَالْعَفْوَ عِنْدَ الْحِسَابِ",
        "tl": "wal 'afwa 'indal hisab",
        "ms": "Kemaafan ketika dihisab",
        "en": "Pardon at the time of reckoning",
        "ml": "വിചാരണാ വേളയിലെ മാപ്പ്",
        "ta": "விசாரணையின் போது மன்னிப்பை"
      }
    },
    {
      "start": "00:00:26,138",
      "end": "00:00:28,373",
      "text": {
        "ar": "وَالْفَوْزَ بِالْجَنَّةِ",
        "tl": "wal fawza bil jannah",
        "ms": "Kemenangan mendapat syurga",
        "en": "Success of Paradise",
        "ml": "സ്വർഗ്ഗലബ്ധിയായ വിജയം",
        "ta": "சுவனத்தின் வெற்றியை"
      }
    },
    {
      "start": "00:00:28,350",
      "end": "00:00:30,773",
      "text": {
        "ar": "وَالنَّجَاةَ مِنَ النَّارِ",
        "tl": "wan najata minan nar",
        "ms": "Keselamatan daripada api neraka",
        "en": "Salvation from the Fire",
        "ml": "നരകത്തിൽ നിന്നുള്ള രക്ഷ",
        "ta": "நரகத்திலிருந்து பாதுகாப்பை"
      }
    },
    {
      "start": "00:00:30,702",
      "end": "00:00:31,714",
      "text": {
        "ar": "بِرَحْمَتِكَ",
        "tl": "birahmatika",
        "ms": "Dengan rahmat-Mu",
        "en": "By Your mercy",
        "ml": "നിന്റെ കാരുണ്യം കൊണ്ട്",
        "ta": "உன் அருளினால்"
      }
    },
    {
      "start": "00:00:31,714",
      "end": "00:00:35,055",
      "text": {
        "ar": "يَا عَزِيزُ يَا غَفَّارُ",
        "tl": "ya 'azizu ya ghaffar",
        "ms": "Wahai Tuhan Yang Maha Perkasa lagi Maha Pengampun",
        "en": "O Mighty, O Forgiving",
        "ml": "പ്രതാപിയും പൊറുക്കുന്നവനുമായവനേ",
        "ta": "கண்ணியமிக்கவனே மன்னிப்பவனே"
      }
    },
    {
      "start": "00:00:35,008",
      "end": "00:00:37,361",
      "text": {
        "ar": "رَبِّ زِدْنِي عِلْمًا",
        "tl": "rabbi zidni 'ilman",
        "ms": "Wahai Tuhanku, tambahkanlah ilmuku",
        "en": "My Lord, increase me in knowledge",
        "ml": "എന്റെ നാഥാ, എനിക്ക് അറിവ് വർദ്ധിപ്പിച്ചു തരേണമേ",
        "ta": "என் இறைவா, எனது கல்வியை அதிகப்படுத்து"
      }
    },
    {
      "start": "00:00:37,337",
      "end": "00:00:40,000",
      "text": {
        "ar": "وَأَلْحِقْنِي بِالصَّالِحِينَ",
        "tl": "wa alhiqni bis-salihin",
        "ms": "Dan golongkanlah aku bersama orang-orang soleh",
        "en": "And join me with the righteous",
        "ml": "എന്നെ സജ്ജനങ്ങളിൽ ചേർക്കേണമേ",
        "ta": "என்னை நல்லவர்களுடன் சேர்த்து வை"
      }
    }
  ]
}