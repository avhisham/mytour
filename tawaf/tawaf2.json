{
  "file_name": "tawaf2.mp3",
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:01,800",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:01,800",
      "end": "00:00:04,800",
      "text": {
        "ar": "إِنَّ هَذَا الْبَيْتَ بَيْتُكَ",
        "tl": "inna hadhal bayta baytuka",
        "ms": "Sesungguhnya Baitullah ini adalah rumah-Mu",
        "en": "Indeed, this House is Your House",
        "ml": "നിശ്ചയമായും ഈ മന്ദിരം നിന്റേതാണ്",
        "ta": "நிச்சயமாக இந்த இல்லம் உன்னுடைய இல்லம்"
      }
    },
    {
      "start": "00:00:04,800",
      "end": "00:00:07,000",
      "text": {
        "ar": "وَالْحَرَمَ حَرَمُكَ",
        "tl": "wal harama haramuka",
        "ms": "Dan Tanah Haram ini adalah milik-Mu",
        "en": "And this Sacred Precinct is Your Sanctuary",
        "ml": "ഈ ഹറം നിന്റേതാണ്",
        "ta": "இந்த ஹரம் உன்னுடைய ஹரம்"
      }
    },
    {
      "start": "00:00:07,000",
      "end": "00:00:09,200",
      "text": {
        "ar": "وَالْأَمْنَ أَمْنُكَ",
        "tl": "wal amna amnuka",
        "ms": "Dan keamanan ini adalah keamanan-Mu",
        "en": "And this safety is Your security",
        "ml": "ഈ അഭയം നിന്റേതാണ്",
        "ta": "இந்த அபயம் உன்னுடைய அபயம்"
      }
    },
    {
      "start": "00:00:09,200",
      "end": "00:00:11,400",
      "text": {
        "ar": "وَالْعَبْدَ عَبْدُكَ",
        "tl": "wal 'abda 'abduka",
        "ms": "Dan hamba ini adalah hamba-Mu",
        "en": "And every slave is Your slave",
        "ml": "ഈ അടിമ നിന്റെ അടിമയാണ്",
        "ta": "இந்த அடியான் உன்னுடைய அடியான்"
      }
    },
    {
      "start": "00:00:11,400",
      "end": "00:00:13,600",
      "text": {
        "ar": "وَأَنَا عَبْدُكَ",
        "tl": "wa ana 'abduka",
        "ms": "Dan aku adalah hamba-Mu",
        "en": "And I am Your slave",
        "ml": "ഞാൻ നിന്റെ അടിമയാണ്",
        "ta": "நானும் உன்னுடைய அடியான்"
      }
    },
    {
      "start": "00:00:13,600",
      "end": "00:00:15,800",
      "text": {
        "ar": "وَابْنُ عَبْدِكَ",
        "tl": "wabnu 'abdika",
        "ms": "Anak kepada hamba-Mu (lelaki)",
        "en": "The son of Your male servant",
        "ml": "നിന്റെ അടിമയുടെ മകൻ",
        "ta": "உன் அடியானின் மகன்"
      }
    },
    {
      "start": "00:00:15,800",
      "end": "00:00:18,500",
      "text": {
        "ar": "وَابْنُ أَمَتِكَ",
        "tl": "wabnu amatika",
        "ms": "Anak kepada hamba-Mu (perempuan)",
        "en": "The son of Your female servant",
        "ml": "നിന്റെ ദാസിയുടെ മകൻ",
        "ta": "உன் அடிமைப் பெண்ணின் மகன்"
      }
    },
    {
      "start": "00:00:18,500",
      "end": "00:00:23,000",
      "text": {
        "ar": "وَهَذَا مَقَامُ الْعَائِذِ بِكَ مِنَ النَّارِ",
        "tl": "wa hadha maqamul 'aidhi bika minan-nar",
        "ms": "Dan inilah tempat orang yang memohon perlindungan-Mu daripada api neraka",
        "en": "And this is the place of one who seeks refuge in You from the Fire",
        "ml": "നരകത്തിൽ നിന്നും നിന്നോട് അഭയം തേടുന്നവന്റെ സ്ഥാനമാണിത്",
        "ta": "நரகத்தை விட்டு உன்னிடம் பாதுகாப்புத் தேடுபவன் நிற்கும் இடம் இது"
      }
    },
    {
      "start": "00:00:23,000",
      "end": "00:00:25,500",
      "text": {
        "ar": "فَحَرِّمْ لُحُومَنَا",
        "tl": "fa harrim luhumana",
        "ms": "Maka haramkanlah daging kami",
        "en": "So forbid our flesh",
        "ml": "അതുകൊണ്ട് ഞങ്ങളുടെ മാംസത്തെ",
        "ta": "எங்கள் மாமிசத்தை"
      }
    },
    {
      "start": "00:00:25,500",
      "end": "00:00:28,500",
      "text": {
        "ar": "وَبَشَرَتَنَا عَلَى النَّارِ",
        "tl": "wa basharatana 'alan-nar",
        "ms": "Dan kulit kami daripada api neraka",
        "en": "And our skin to the Fire",
        "ml": "ഞങ്ങളുടെ ചർമ്മത്തെ നരകത്തിന് നിഷിദ്ധമാക്കേണമേ",
        "ta": "எங்கள் சருமத்தை நரகத்திற்கு ஹராமாக்குவாயாக"
      }
    },
    {
      "start": "00:00:28,500",
      "end": "00:00:30,200",
      "text": {
        "ar": "اللَّهُمَّ",
        "tl": "Allahumma",
        "ms": "Ya Allah",
        "en": "O Allah",
        "ml": "അല്ലാഹുവേ",
        "ta": "யா அல்லாஹ்"
      }
    },
    {
      "start": "00:00:30,200",
      "end": "00:00:33,200",
      "text": {
        "ar": "حَبِّبْ إِلَيْنَا الْإِيمَانَ",
        "tl": "habbib ilaynal iman",
        "ms": "Cintakanlah kami kepada iman",
        "en": "Make faith beloved to us",
        "ml": "ഈമാൻ ഞങ്ങൾക്ക് പ്രിയങ്കരമാക്കേണമേ",
        "ta": "ஈமானை எங்களுக்குப் பிரியமானதாக்கு"
      }
    },
    {
      "start": "00:00:33,200",
      "end": "00:00:35,700",
      "text": {
        "ar": "وَزَيِّنْهُ فِي قُلُوبِنَا",
        "tl": "wa zayyinhu fi qulubina",
        "ms": "Dan hiaskannya di dalam hati kami",
        "en": "And beautify it in our hearts",
        "ml": "അത് ഞങ്ങളുടെ ഹൃദയങ്ങളിൽ അലംകൃതമാക്കേണമേ",
        "ta": "அதை எங்கள் இதயங்களில் அழகாக்கு"
      }
    },
    {
      "start": "00:00:35,700",
      "end": "00:00:38,200",
      "text": {
        "ar": "وَكَرِّهْ إِلَيْنَا الْكُفْرَ",
        "tl": "wa karrih ilaynal kufra",
        "ms": "Dan bencikanlah kami kepada kekufuran",
        "en": "And make hateful to us disbelief",
        "ml": "കുഫ്റിനെയും അധർമ്മത്തെയും",
        "ta": "குஃப்ரு, பாவம் மற்றும்"
      }
    },
    {
      "start": "00:00:38,200",
      "end": "00:00:41,200",
      "text": {
        "ar": "وَالْفُسُوقَ وَالْعِصْيَانَ",
        "tl": "wal fusuqa wal 'isyan",
        "ms": "Kefasikan dan kederhakaan",
        "en": "Wickedness, and disobedience",
        "ml": "അനുസരണക്കേടിനെയും ഞങ്ങളിൽ വെറുപ്പുള്ളതാക്കേണമേ",
        "ta": "மாறு செய்வதை எங்களுக்கு வெறுப்பாக்கு"
      }
    },
    {
      "start": "00:00:41,200",
      "end": "00:00:44,000",
      "text": {
        "ar": "وَاجْعَلْنَا مِنَ الرَّاشِدِينَ",
        "tl": "waj'alna minar-rashidin",
        "ms": "Dan jadikanlah kami daripada golongan yang mendapat petunjuk",
        "en": "And make us among the rightly guided",
        "ml": "ഞങ്ങളെ സന്മാർഗ്ഗികളിൽ ഉൾപ്പെടുത്തേണമേ",
        "ta": "நேர்வழி பெற்றவர்களில் எங்களைச் சேர்த்துவிடு"
      }
    },
    {
      "start": "00:00:44,000",
      "end": "00:00:46,500",
      "text": {
        "ar": "اللَّهُمَّ ارْزُقْنِي الْجَنَّةَ",
        "tl": "Allahummar-zuqnil jannah",
        "ms": "Ya Allah, kurniakanlah aku syurga",
        "en": "O Allah, grant me Paradise",
        "ml": "അല്ലാഹുവേ, എനിക്ക് സ്വർഗ്ഗം നൽകേണമേ",
        "ta": "யா அல்லாஹ், எனக்கு சொர்க்கத்தை வழங்கு"
      }
    },
    {
      "start": "00:00:46,500",
      "end": "00:00:48,500",
      "text": {
        "ar": "بِغَيْرِ حِسَابٍ",
        "tl": "bi ghayri hisab",
        "ms": "Tanpa hisab",
        "en": "Without account",
        "ml": "യാതൊരു വിചാരണയും കൂടാതെ",
        "ta": "எந்த விசாரணையுமின்றி"
      }
    }
  ]
}