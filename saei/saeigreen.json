{
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:02,500",
      "text": {
        "ar": "رَبِّ اغْفِرْ وَارْحَمْ",
        "tl": "Rabbi-ghfir warḥam",
        "ms": "Wahai Tuhanku! Ampunilah dan kasihanilah,",
        "en": "My Lord! Forgive and have mercy,",
        "ml": "എന്റെ രക്ഷിതാവേ! പൊറുത്തുതരികയും കരുണ ചെയ്യുകയും ചെയ്യേണമേ,",
        "ta": "என் இறைவா! மன்னித்து அருள் புரிவாயாக,"
      }
    },
    {
      "start": "00:00:05,000",
      "end": "00:00:07,500",
      "text": {
        "ar": "وَاعْفُ وَتَكَرَّمْ",
        "tl": "wa'fu wa takarram",
        "ms": "maafkanlah dan muliakanlah,",
        "en": "pardon and be generous,",
        "ml": "മാപ്പാക്കുകയും ഉദാരത കാണിക്കുകയും ചെയ്യേണമേ,",
        "ta": "பிழை பொறுத்து கண்ணியப்படுத்துவாயாக,"
      }
    },
    {
      "start": "00:00:10,000",
      "end": "00:00:13,000",
      "text": {
        "ar": "وَتَجَاوَزْ عَمَّا تَعْلَمْ",
        "tl": "wa tajāwaz 'ammā ta'lam",
        "ms": "dan maafkanlah apa yang Engkau ketahui,",
        "en": "and overlook what You know,",
        "ml": "നിനക്കറിയാവുന്ന പാപങ്ങൾ വിട്ടുവീഴ്ച ചെയ്യേണമേ,",
        "ta": "நீ அறிந்திருக்கும் குற்றங்களை மன்னித்தருள்வாயாக,"
      }
    },
    {
      "start": "00:00:15,500",
      "end": "00:00:19,000",
      "text": {
        "ar": "إِنَّكَ تَعْلَمُ مَا لَا نَعْلَمُ",
        "tl": "innaka ta'lamu mā lā na'lam",
        "ms": "sesungguhnya Engkau mengetahui apa yang kami tidak ketahui,",
        "en": "indeed You know that which we know not,",
        "ml": "തീർച്ചയായും ഞങ്ങൾക്ക് അറിയാത്തത് നീ അറിയുന്നു,",
        "ta": "நாங்கள் அறியாததை நிச்சயமாக நீ அறிவாய்,"
      }
    },
    {
      "start": "00:00:21,500",
      "end": "00:00:25,500",
      "text": {
        "ar": "إِنَّكَ أَنْتَ اللَّهُ الأَعَزُّ الأَكْرَمُ",
        "tl": "innaka Antal-Lāhul-A'azzul-Akram",
        "ms": "sesungguhnya Engkaulah Allah yang Maha Perkasa lagi Maha Mulia.",
        "en": "truly You are Allah, the Most Mighty, the Most Generous.",
        "ml": "നീ തന്നെയാണ് ഏറ്റവും പ്രതാപിയും ഔദാര്യവാനുമായ അല്ലാഹു.",
        "ta": "நிச்சயமாக நீயே யாவற்றிலும் மிகைத்தவனும், மிக்க கண்ணியமிக்கவனுமாகிய அல்லாஹ்."
      }
    }
  ]
}