{
  "subtitles": [
    {
      "start": "00:00:00,000",
      "end": "00:00:02,000",
      "text": {
        "ar": "رَبِّ اغْفِرْ وَارْحَمْ",
        "tl": "Rabbi-ghfir warḥam",
        "ms": "Ya Allah! Ampunilah daku, rahmatilah daku,",
        "en": "O my Lord! Forgive and have mercy,",
        "ml": "എന്റെ രക്ഷിതാവേ! പൊറുത്തുതരികയും കരുണ കാണിക്കുകയും ചെയ്യേണമേ,",
        "ta": "என் இறைவா! மன்னித்து அருள் புரிவாயாக,"
      }
    },
    {
      "start": "00:00:03,000",
      "end": "00:00:05,000",
      "text": {
        "ar": "وَاعْفُ وَتَكَرَّمْ",
        "tl": "wa'fu wa takarram",
        "ms": "maafkanlah daku dan kurniakan kemuliaan,",
        "en": "pardon and be generous,",
        "ml": "മാപ്പാക്കുകയും ഉദാരത കാണിക്കുകയും ചെയ്യേണമേ,",
        "ta": "மன்னித்து தாராளமாக அருள்வாயாக,"
      }
    },
    {
      "start": "00:00:06,000",
      "end": "00:00:08,500",
      "text": {
        "ar": "وَتَجَاوَزْ عَمَّا تَعْلَمْ",
        "tl": "wa tajāwaz 'ammā ta'lam",
        "ms": "dan ampunilah segala apa yang Engkau ketahui,",
        "en": "and overlook what You know,",
        "ml": "നിനക്കറിയാവുന്ന ഞങ്ങളുടെ പാപങ്ങൾ വിട്ടുവീഴ്ച ചെയ്യേണമേ,",
        "ta": "உனக்குத் தெரிந்த குற்றங்களைப் பொறுத்தருள்வாயாக,"
      }
    },
    {
      "start": "00:00:09,500",
      "end": "00:00:12,000",
      "text": {
        "ar": "إِنَّكَ تَعْلَمُ مَا لَا نَعْلَمُ",
        "tl": "innaka ta'lamu mā lā na'lam",
        "ms": "sesungguhnya Engkau mengetahui apa yang kami tidak ketahui,",
        "en": "Indeed, You know what we do not know,",
        "ml": "നിശ്ചയമായും, ഞങ്ങൾക്ക് അറിയാത്തത് നീ അറിയുന്നു,",
        "ta": "நிச்சயமாக, எங்களுக்குத் தெரியாததை நீ அறிவாய்,"
      }
    },
    {
      "start": "00:00:13,000",
      "end": "00:00:15,500",
      "text": {
        "ar": "إِنَّكَ الْأَعَزُّ الْأَكْرَمُ",
        "tl": "innaka l-a'azzu l-akram",
        "ms": "sesungguhnya Engkaulah Yang Maha Mulia lagi Maha Terpuji.",
        "en": "Indeed, You are the Most Mighty, the Most Generous.",
        "ml": "നിശ്ചയമായും നീ ഏറ്റവും പ്രതാപിയും ഏറ്റവും ഔദാര്യവാനുമാകുന്നു.",
        "ta": "நிச்சயமாக நீயே மிகவும் கண்ணியமானவனும், மிக்க கொடையாளியுமாவாய்."
      }
    }
  ]
}