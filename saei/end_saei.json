{
  "_mock": true,
  "_note": "Dua recited at the end of Trip 7 upon completing all 7 trips of Sa'i — unique to trip 7 only.",
  "subtitles": {
    "ar": [
      { "start": "00:00:00,000", "end": "00:00:04,000", "text": "اللهمَّ تَقَبَّلْ مِنَّا سَعْيَنَا" },
      { "start": "00:00:05,000", "end": "00:00:09,000", "text": "كَمَا تَقَبَّلْتَ مِنْ نَبِيِّكَ إِبْرَاهِيمَ عَلَيْهِ السَّلَامُ" },
      { "start": "00:00:10,000", "end": "00:00:13,000", "text": "وَمِنْ خَلِيلِكَ إِبْرَاهِيمَ" },
      { "start": "00:00:14,000", "end": "00:00:18,000", "text": "رَبَّنَا تَقَبَّلْ مِنَّا إِنَّكَ أَنتَ السَّمِيعُ الْعَلِيمُ" }
    ],
    "tl": [
      { "start": "00:00:00,000", "end": "00:00:04,000", "text": "Allāhumma taqabbal minnā sa'yanā" },
      { "start": "00:00:05,000", "end": "00:00:09,000", "text": "kamā taqabbalta min nabiyyika Ibrāhīm 'alayhis-salām" },
      { "start": "00:00:10,000", "end": "00:00:13,000", "text": "wa min khalīlika Ibrāhīm" },
      { "start": "00:00:14,000", "end": "00:00:18,000", "text": "Rabbanā taqabbal minnā innaka antas-Samī'ul-'Alīm" }
    ],
    "en": [
      { "start": "00:00:00,000", "end": "00:00:04,000", "text": "O Allah, accept our Sa'i" },
      { "start": "00:00:05,000", "end": "00:00:09,000", "text": "as You accepted from Your Prophet Ibrahim, peace be upon him." },
      { "start": "00:00:10,000", "end": "00:00:13,000", "text": "And from Your friend Ibrahim." },
      { "start": "00:00:14,000", "end": "00:00:18,000", "text": "Our Lord, accept from us. Indeed, You are the All-Hearing, All-Knowing." }
    ],
    "ms": [
      { "start": "00:00:00,000", "end": "00:00:04,000", "text": "Ya Allah, terimalah Sa'i kami" },
      { "start": "00:00:05,000", "end": "00:00:09,000", "text": "sepertimana Engkau menerima daripada Nabi-Mu Ibrahim alayhis-salam." },
      { "start": "00:00:10,000", "end": "00:00:13,000", "text": "Dan daripada kekasih-Mu Ibrahim." },
      { "start": "00:00:14,000", "end": "00:00:18,000", "text": "Wahai Tuhan kami, terimalah daripada kami. Sesungguhnya Engkau Maha Mendengar lagi Maha Mengetahui." }
    ],
    "ml": [
      { "start": "00:00:00,000", "end": "00:00:04,000", "text": "അല്ലാഹുവേ, ഞങ്ങളുടെ സഅയ് സ്വീകരിക്കേണമേ" },
      { "start": "00:00:05,000", "end": "00:00:09,000", "text": "നിൻ്റെ പ്രവാചകൻ ഇബ്രാഹിം (അ) ൽ നിന്ന് സ്വീകരിച്ചത് പോലെ." },
      { "start": "00:00:10,000", "end": "00:00:13,000", "text": "നിൻ്റെ ഉറ്റ ചങ്ങാതി ഇബ്രാഹിമിൽ നിന്ന് സ്വീകരിച്ചത് പോലെ." },
      { "start": "00:00:14,000", "end": "00:00:18,000", "text": "ഞങ്ങളുടെ രക്ഷിതാവേ, ഞങ്ങളിൽ നിന്ന് ഇത് സ്വീകരിക്കേണമേ. നീ സർവ്വ കേൾക്കുന്നവനും സർവ്വ അറിയുന്നവനുമാണ്." }
    ],
    "ta": [
      { "start": "00:00:00,000", "end": "00:00:04,000", "text": "யா அல்லாஹ், எங்கள் ஸயீயை ஏற்றுக்கொள்வாயாக" },
      { "start": "00:00:05,000", "end": "00:00:09,000", "text": "உன்னுடைய நபி இப்ராஹீம் (அலை) அவர்களிடம் ஏற்றுக்கொண்டதைப்போல." },
      { "start": "00:00:10,000", "end": "00:00:13,000", "text": "உன்னுடைய நெருங்கிய நண்பர் இப்ராஹீமிடம் ஏற்றுக்கொண்டதைப்போல." },
      { "start": "00:00:14,000", "end": "00:00:18,000", "text": "எங்கள் இறைவா, எங்களிடமிருந்து இதை ஏற்றுக்கொள். நீ எல்லாவற்றையும் கேட்பவன், அறிபவன்." }
    ]
  }
}
